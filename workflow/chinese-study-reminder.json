    {
      "parameters": {
        "promptType": "define",
        "text": "=Lời nhắc từ Agent 1:\n{{ $('Chinese Study Reminder').item.json.output }}\n\nTừ vựng hôm nay:\n{{ $json['TỪ VỰNG'] }} - {{ $json.PINYIN }} - {{ $json['NGHĨA'] }}",
        "options": {
          "systemMessage": "Bạn là AI Agent 2 - Study Manager.\nBạn nhận lời nhắc của Agent 1 và một từ vựng hôm nay.\nGiữ giọng cute, ngắn gọn của lời nhắc, rồi thêm cuối tin mục \"Từ hôm nay\" gồm chữ Hán, pinyin và nghĩa, kèm một câu ví dụ ngắn.\nChỉ trả về văn bản thuần, không Markdown table, không ký tự |, không tiêu đề, không giải thích, không dấu ngoặc kép bao quanh.",
          "maxIterations": 5
        }
      },
